# NEMRAS backend environment configuration - EXAMPLE ONLY.
#
# Copy this file to `backend/.env` and fill in values for your machine.
# `.env` is git-ignored; this example file is committed. Never put a real
# credential, private key or service-account body in either file.

# ------------------------------------------------------------------
# Firebase Admin SDK credentials
# ------------------------------------------------------------------
# Absolute path to the Firebase service-account JSON used to verify ID tokens.
# Download it from Firebase Console -> Project settings -> Service accounts.
#
# Keep this file OUTSIDE the repository. It is a private key: it must never be
# committed, pasted into source, attached to an issue, or shared.
#
# Leave unset to use Application Default Credentials instead (for example a
# workload identity or an attached service account in a managed environment).
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/repo/nemras-service-account.json

# The Firebase project whose ID tokens this backend will accept. Tokens minted
# by any other project are rejected. Defaults to nemras-3230f when unset.
NEMRAS_FIREBASE_PROJECT_ID=nemras-3230f

# ------------------------------------------------------------------
# Supabase Auth (optional; accepted alongside Firebase on /api/v1/me/*)
# ------------------------------------------------------------------
# Project URL of a DEVELOPMENT Supabase project, e.g.
# https://<project-ref>.supabase.co  (no trailing path). Not a secret.
# Leave unset to disable Supabase verification entirely.
#
# Only asymmetric signing keys (ES256/RS256) are accepted. Public keys are
# fetched from <SUPABASE_URL>/auth/v1/.well-known/jwks.json, so the backend
# needs NO Supabase secret. Never put the service-role key, a sb_secret_ key,
# the legacy JWT secret or the database password in this file.
SUPABASE_URL=https://your-dev-project-ref.supabase.co

# ------------------------------------------------------------------
# SQLite identity store (A2 foundation; no binding API exists yet)
# ------------------------------------------------------------------
# Absolute path to the SQLite file. Keep the database outside the repository.
# The containing directory must normally exist; future startup integration
# will decide explicitly whether creating it is permitted.
NEMRAS_IDENTITY_DB_PATH=/absolute/path/outside/this/repo/nemras-identity.sqlite3

# Key for deterministic HMAC-SHA-256 pseudonymous references. Use a unique,
# high-entropy secret of at least 32 bytes supplied by your deployment secret
# manager. This is a placeholder and must be replaced before use.
# Never reuse a Firebase key, password, OTP, CNIC, or phone number here.
NEMRAS_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-bytes
