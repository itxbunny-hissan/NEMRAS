# ---------------------------------------------------------------
# Python / FastAPI backend
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
.venv*/
# Generated by flutter test/analyze in the shared packages, which have no
# .gitignore of their own.
packages/*/.dart_tool/
packages/*/build/
env/

# Backend runtime / log output (generated by uvicorn, not source)
backend/uvicorn_out.txt
backend/uvicorn_err.txt
*.log

# Local identity stores and SQLite runtime sidecars
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Generated patient-ID registry. The file is also covered by the SQLite rules.
backend/runtime/

# ---------------------------------------------------------------
# Local secrets - never commit credentials or service accounts
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*-service-account*.json
serviceAccountKey*.json

# ---------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
